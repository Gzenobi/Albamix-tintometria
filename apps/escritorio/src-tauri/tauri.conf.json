{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Albamix Tintometria",
  "version": "0.1.0",
  "identifier": "com.akzonobel.albamix.tintometria",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Albamix Tintometría",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "AkzoNobel - versión de prueba",
    "shortDescription": "Albamix tintometría",
    "longDescription": "Dosificación de colores y precios para distribuidores Albamix. Funciona sin conexión.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish"],
        "displayLanguageSelector": false
      }
    }
  }
}
